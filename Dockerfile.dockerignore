# Per-Dockerfile dockerignore for the slim build (Dockerfile).
# Keep minimal — slim image needs .git (for VERSION), web/ (frontend), rag/res/deepdoc.
# Lambda build keeps the broader exclusions in .dockerignore.

# Python build artifacts
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# Env files (these contain secrets)
.env
.venv/
venv/
ENV/

# Docker / AWS
.docker/
.aws-sam/

# Local logs and stash
build-logs/
