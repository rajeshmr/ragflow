FROM public.ecr.aws/lambda/python:3.10

# Create larger tmp directory
RUN mkdir -p /tmp/build && chmod 777 /tmp/build

# Set environment variables
ENV TMPDIR=/tmp/build
ENV VIRTUAL_ENV=/var/lang
ENV PATH="/var/lang/bin:$PATH"

# Install system dependencies
RUN yum update -y && \
    yum groupinstall -y "Development Tools" && \
    yum install -y \
    python3-devel \
    gcc \
    gcc-c++ \
    make \
    git \
    tar \
    postgresql-devel \
    libjpeg-devel \
    zlib-devel \
    poppler-utils \
    cairo-devel \
    pango-devel \
    libffi-devel \
    openssl-devel \
    bzip2-devel \
    libxml2-devel \
    libxslt-devel \
    icu-devel \
    && yum clean all

# Install uv
RUN pip install uv

# Set working directory
WORKDIR ${LAMBDA_TASK_ROOT}

# Copy requirements first for better caching
COPY requirements.full.txt .
RUN uv sync -r requirements.full.txt

# Copy application code
COPY api api/
COPY conf conf/
COPY rag rag/
COPY deepdoc deepdoc/
COPY agent agent/
COPY graphrag graphrag/
COPY pyproject.toml ./

# Set environment variables
ENV PYTHONPATH=/var/task
ENV STAGE=prod

# Set the handler
CMD [ "api.ragflow_server.lambda_handler" ]
