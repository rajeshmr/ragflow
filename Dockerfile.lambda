FROM public.ecr.aws/lambda/python:3.10

# Set the working directory
WORKDIR /var/task

# Copy dependency descriptor files
COPY pyproject.toml uv.lock ./

# Create a Python virtual environment in /var/task/.venv
RUN python -m venv .venv

# Set up environment variables to use the virtual environment
ENV VIRTUAL_ENV=/var/task/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install uv package manager
RUN pip install uv

# Install Python dependencies using uv
RUN uv sync --python 3.10 --frozen

# Copy the rest of your application code
COPY . .

# Set PYTHONPATH for the application
ENV PYTHONPATH=/var/task

# Define the Lambda entrypoint
CMD ["api.ragflow_server.lambda_handler"]