# Stage 1: Builder stage - for compiling and installing dependencies
FROM public.ecr.aws/lambda/provided:al2-x86_64 AS builder

USER root
WORKDIR /var/task

# Install build dependencies for C extensions, LLVM, ICU, and curl
RUN yum update -y && \
    yum groupinstall -y "Development Tools" && \
    yum install -y gcc-c++ python3-devel python3-venv llvm-devel \
    libicu-devel libffi-devel openssl-devel curl \
    mesa-libGL unixODBC unixODBC-devel python3-pip && \
    yum clean all && \
    rm -rf /var/cache/yum

# Install Rust toolchain (rustup) for compiling Rust extensions (required for primp package v0.14.0+)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal

# Set Rust environment variables so Cargo is available
ENV CARGO_HOME=/root/.cargo
ENV PATH=/root/.cargo/bin:${PATH}
ENV UV_HTTP_TIMEOUT=120

# Set Python path
ENV PYTHONPATH=/var/task

# Copy only dependency files first for better caching
COPY pyproject.toml uv.lock ./

# Install dependencies directly without using uv
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install xgboost onnxruntime 

# Download NLTK data
RUN python3 -m pip install nltk && \
    python3 -m nltk.downloader wordnet punkt_tab

# Stage 2: Final slim image - contains only runtime dependencies
FROM public.ecr.aws/lambda/provided:al2-x86_64

USER root
WORKDIR /var/task

# Install only runtime dependencies (not build tools)
RUN yum update -y && \
    yum install -y libicu curl mesa-libGL unixODBC && \
    yum clean all && \
    rm -rf /var/cache/yum

# Copy NLTK data from builder stage
COPY --from=builder /root/nltk_data /root/nltk_data

ENV PATH=/usr/local/bin:${PATH}
ENV PYTHONPATH=/var/task

# Copy application code
COPY api api
COPY conf conf
COPY deepdoc deepdoc
COPY rag rag
COPY agent agent
COPY graphrag graphrag
COPY agentic_reasoning agentic_reasoning

# Copy config files and scripts
COPY docker/service_conf.yaml.template ./conf/service_conf.yaml.template
COPY docker/entrypoint.sh ./

# Set environment variables for networking
ENV HOST_IP="0.0.0.0"
ENV HOST_PORT=80

# Set environment variables for enhanced logging
ENV DEBUG=false
ENV VERBOSE=false
ENV PYTHONUNBUFFERED=1
ENV PYTHONIOENCODING=UTF-8
ENV LOG_LEVEL=DEBUG

# Expose port 80 for HTTP traffic
EXPOSE 80

# Make entrypoint script executable 
RUN chmod +x ./entrypoint.sh

# Override the default Lambda entrypoint
ENTRYPOINT ["./entrypoint.sh"]