# Stage 1: Builder stage - for compiling and installing dependencies
FROM public.ecr.aws/lambda/python:3.12 AS builder

USER root
WORKDIR /var/task

# Install build dependencies for C extensions, LLVM, ICU, and curl.
# Lambda Python 3.12 base = Amazon Linux 2023; uses dnf, not yum.
# python3-venv is no longer a separate package on AL2023 (venv is bundled
# with python3); curl is available as curl-minimal already.
RUN dnf update -y && \
    dnf group install -y "Development Tools" && \
    dnf install -y libicu-devel gcc-c++ python3-devel llvm-devel \
        libffi-devel openssl-devel \
        mesa-libGL unixODBC unixODBC-devel python3-pip && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# Install Rust toolchain (rustup) for compiling Rust extensions (required for primp package v0.14.0+)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal

# Set Rust environment variables so Cargo is available
ENV CARGO_HOME=/root/.cargo
ENV PATH=/root/.cargo/bin:${PATH}
ENV UV_HTTP_TIMEOUT=120

# Set Python path
ENV PYTHONPATH=/var/task

# Copy only dependency files first for better caching
COPY pyproject.toml ./

# Check Python version
RUN python3 --version

# Install pip and tomli first
RUN python3 -m pip install --upgrade pip tomli

# Install NLTK and download required data
RUN python3 -m pip install nltk && \
    python3 -m nltk.downloader wordnet punkt_tab

# Generate requirements and exclude mini-racer for separate handling
RUN python3 -c "import tomli; import sys; \
    deps = tomli.load(open('pyproject.toml', 'rb'))['project']['dependencies']; \
    # Replace onnxruntime and exclude problematic packages (pyicu, mini-racer) \
    deps_fixed = [d.replace('onnxruntime-gpu==1.19.2', 'onnxruntime==1.16.3').replace('onnxruntime==1.19.2', 'onnxruntime==1.16.3') for d in deps if not d.startswith('pyicu') and not d.startswith('mini-racer')]; \
    print('\n'.join(deps_fixed))" > requirements.txt && \
    cat requirements.txt && \
    python3 -m pip install -r requirements.txt

# Skip mini-racer installation - it requires building V8 from source which takes 30-90+ minutes
# mini-racer is only used by akshare for specific encrypted data sources and is not critical
# If needed in future, consider using a pre-built Docker image with V8 or alternative packages
RUN echo "Skipping mini-racer installation (requires lengthy V8 compilation)"

# Install xgboost separately (sometimes has conflicts with other packages)
RUN python3 -m pip install xgboost

# Stage 2: Final slim image - contains only runtime dependencies
FROM public.ecr.aws/lambda/python:3.12

USER root
WORKDIR /var/task

# Install only runtime dependencies (not build tools).
# AL2023 uses dnf. hostname package replaced with hostname-base (or use
# hostnamectl from systemd, but Lambda runtime won't have systemd).
RUN dnf update -y && \
    dnf install -y libicu mesa-libGL unixODBC && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# Copy Python packages from builder stage
COPY --from=builder /var/lang/lib/python3.12/site-packages/ /var/lang/lib/python3.12/site-packages/
COPY --from=builder /var/runtime/ /var/runtime/

# Copy NLTK data from builder stage
COPY --from=builder /root/nltk_data /root/nltk_data

# Set Python path
ENV PYTHONPATH=/var/task

# Copy application code
COPY api api
COPY conf conf
COPY deepdoc deepdoc
COPY rag rag
COPY agent agent
COPY mcp mcp
# v0.25.1+: shared modules (settings, doc_store, decorator, etc.) and the memory feature.
# Note: top-level graphrag/, plugin/, and agentic_reasoning/ were removed in v0.25.1
# (graphrag moved into rag/graphrag/, plugin/ deleted, agentic_reasoning/ deleted).
COPY common common
COPY memory memory

# Copy config files and scripts
COPY docker/service_conf.yaml.template ./conf/service_conf.yaml.template
COPY docker/entrypoint-lambda.sh ./

# Set environment variables for networking
ENV HOST_IP="0.0.0.0"
ENV HOST_PORT=80

# Set environment variables for enhanced logging
ENV DEBUG=false
ENV VERBOSE=false
ENV PYTHONUNBUFFERED=1
ENV PYTHONIOENCODING=UTF-8
ENV LOG_LEVEL=DEBUG

# Expose port 80 for HTTP traffic
EXPOSE 80

# Make entrypoint script executable 
RUN chmod +x ./entrypoint-lambda.sh

# Override the default Lambda entrypoint
ENTRYPOINT ["./entrypoint-lambda.sh"]
