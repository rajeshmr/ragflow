FROM public.ecr.aws/lambda/python:3.10

USER root
WORKDIR /var/task

# Set environment variables for the virtual environment and Python path
ENV VIRTUAL_ENV=/var/task/.venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV PYTHONPATH=/var/task

# Install build dependencies for C extensions, LLVM, and ICU
RUN yum update -y && \
    yum groupinstall -y "Development Tools" && \
    yum install -y gcc-c++ python3-devel llvm-devel libicu-devel libffi-devel openssl-devel && \
    yum clean all

# Copy dependency descriptor files
COPY pyproject.toml requirements.api.txt ./

# Create a virtual environment, upgrade pip, and install dependencies manually
RUN python -m venv ${VIRTUAL_ENV} && \
    pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.api.txt --no-deps && \
    pip install numpy pandas transformers nltk requests

# Copy application code and configuration files

COPY api api
COPY conf conf
COPY deepdoc deepdoc
COPY rag rag
COPY agent agent
COPY graphrag graphrag
COPY docker/service_conf.yaml.template ./conf/service_conf.yaml.template
COPY docker/entrypoint.sh docker/entrypoint-parser.sh ./

# Set environment variables for networking
ENV HOST_IP="0.0.0.0"
ENV HOST_PORT=80

# Expose port 80 for HTTP traffic
EXPOSE 80

# Make entrypoint script executable
RUN chmod +x ./entrypoint.sh

# Override the default Lambda entrypoint
ENTRYPOINT []

# Define the command to run the Flask application
CMD ["python", "-m", "api.ragflow_server"]